# KAI configuration — copy to .env and fill in real values:  cp .env.example .env

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible chat completions endpoint) — e.g. local Ollama
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama                        # any non-empty string for local Ollama
LLM_MODEL=qwen2.5:14b-instruct            # validated for grounded prose QA (NOT the -coder variant)
LLM_TIMEOUT=120                           # seconds

# ---------------------------------------------------------------------------
# Embeddings (OpenAI-compatible embeddings endpoint)
# ---------------------------------------------------------------------------
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=nomic-embed-text              # 768-dim, 8192-token context (good RAG fit)
EMBED_DIMENSIONS=768                      # MUST match the model; changing it requires a full re-ingest

# ---------------------------------------------------------------------------
# Database (Postgres + pgvector)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kai   # change to your DB credentials
VECTOR_TABLE=kai_chunks
VECTOR_TYPE=vector                       # vector (float32, default) | halfvec (fp16, 2x smaller, large scale)

# ---------------------------------------------------------------------------
# Confluence (knowledge base source)
#   • PUBLIC space  → leave EMAIL + API_TOKEN blank (anonymous).
#   • Cloud PRIVATE → set EMAIL + API_TOKEN (HTTP Basic with a Cloud API token).
#   • Server/DC     → EMAIL + API_TOKEN as username + password (Basic), OR leave
#                     EMAIL blank and put a Personal Access Token in API_TOKEN (Bearer).
#   • MAX_DOCS=0 ingests the whole space; >0 caps it (handy for a first test).
# ---------------------------------------------------------------------------
CONFLUENCE_BASE_URL=https://cwiki.apache.org/confluence
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=COMDEV
CONFLUENCE_MAX_DOCS=40
# Optional: index ONE page + all its descendant pages (a subtree) instead of the
# whole space. Accepts a page id or an exact page title. Blank = whole space.
CONFLUENCE_ROOT_PAGE=

# --- Multiple Confluence instances (optional) ------------------------------
# The FLAT vars above are INSTANCE #1 (note: it's the un-numbered block, NOT
# CONFLUENCE_1_*). Add more instances with numbered vars below. Each instance has its
# OWN base URL, spaces, and auth — a numbered instance NEVER inherits #1's creds.
# Auth per instance: email+token = private (Basic) · token only = Server/DC PAT
# (Bearer) · both blank = public · email-only = error.
# Mix Cloud + self-hosted and public + private freely. Numbering gaps are fine
# (e.g. _2 then _12); on startup the log prints how many instances were found.

# Instance #2 — example: a self-hosted Server/DC wiki using a Personal Access Token
# CONFLUENCE_2_BASE_URL=https://wiki.company.com
# CONFLUENCE_2_SPACE_KEY=DOCS,OPS
# CONFLUENCE_2_EMAIL=                       # leave blank for a PAT (Bearer)...
# CONFLUENCE_2_API_TOKEN=                   # ...put the Personal Access Token here
# CONFLUENCE_2_ROOT_PAGE=
# CONFLUENCE_2_MAX_DOCS=0

# Instance #3 … add as many as you want (copy the block, bump the number)
# CONFLUENCE_3_BASE_URL=https://team.atlassian.net/wiki
# CONFLUENCE_3_SPACE_KEY=TEAM
# CONFLUENCE_3_EMAIL=
# CONFLUENCE_3_API_TOKEN=

# ---------------------------------------------------------------------------
# Knowledge source selection — what KAI ingests (see doc/sources.md)
# ---------------------------------------------------------------------------
# SOURCE_TYPE=confluence                   # confluence | files | confluence+files
# SOURCE_DIR=./samples                     # one directory of files
# SOURCE_DIRS=./samples,/mnt/handbook      # OR several dirs (comma-separated; overrides SOURCE_DIR)
# FILE_MAX_BYTES=25000000                  # skip files larger than this (~25 MB)

# ---------------------------------------------------------------------------
# Jira Cloud (escalation tracker) — optional; blank = escalations are logged (no ticket).
# ---------------------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# ---------------------------------------------------------------------------
# Webex bot (chat surface) — outbound websocket, NO public URL / tunnel needed.
#   Create a bot at developer.webex.com → My Webex Apps → Create a Bot,
#   then paste its access token here.
# ---------------------------------------------------------------------------
WEBEX_BOT_TOKEN=

# --- Chat platform (the bot process is a thin client over /ask) ---
CHAT_PLATFORM=webex                        # webex | slack | teams
# WEBEX_FEEDBACK_CARD=false                # 👍/👎/escalate card under answers
# WEBEX_EDIT_IN_PLACE=true                 # (default) edit the 'searching…' msg into the answer
# CONVERSATION_MEMORY=false                # (experimental) per-thread follow-up context
# BOT_ACK_MESSAGE=🔎 _Searching the knowledge base…_    # the instant 'thinking' message
# BOT_ANSWER_PREFIX=Here's what I found:                 # bolded above the answer (blank = none)
# --- Slack (CHAT_PLATFORM=slack; pip install -e '.[slack]') ---
# SLACK_BOT_TOKEN=xoxb-...                 # scopes: app_mentions:read, chat:write, commands
# SLACK_APP_TOKEN=xapp-...                 # Socket Mode: connections:write
KAI_API_URL=http://127.0.0.1:8100         # where the bot reaches the KAI API
# Restrict who the bot answers (comma-separated). Blank = anyone in the space.
WEBEX_APPROVED_DOMAINS=
WEBEX_APPROVED_USERS=

# ---------------------------------------------------------------------------
# API auth — blank is fine for LOCAL dev only. REQUIRED before exposing the API on
# any network: without it the whole corpus is readable by anyone who can reach it.
# Clients (and the bot) then send `Authorization: Bearer <it>`.
# ---------------------------------------------------------------------------
KAI_API_KEY=
# CORS origins allowed to call the API from a browser (the web frontend is a
# SEPARATE origin — see frontend/). Comma-separated EXACT URLs; blank = no
# cross-origin browser access. NEVER set "*" on an internet-exposed or
# unauthenticated API (any website could then read your corpus).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Retrieval / answering  (tuned defaults — 0% false-answers, recall@1 ~83%)
# ---------------------------------------------------------------------------
TOP_K=8
CONFIDENCE_THRESHOLD=0.45                 # eval-calibrated (golden set): below this → escalate
RERANKER=cross_encoder                    # noop | cross_encoder (big recall + accuracy win)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MULTI_QUERY=true                          # 2 LLM reformulations, union + rerank (recall on casual phrasing)
# Latency note: QUERY_REWRITE, MULTI_QUERY, and the answer verifier each add ONE
# serial LLM call per answered question (more accuracy, more latency). A confident
# answer is ~3 calls on a local 14B model; escalations skip generation + verify;
# repeats are served from the answer cache.
# NORMALIZE_QUERY=true                     # (default on) strip "show me details of …" filler before ranking
RERANK_CANDIDATES=20                      # retrieve this many, rerank, keep TOP_K
QUERY_REWRITE=false                       # LLM spell/grammar fix before retrieval (off: no gain on nomic)

# ---------------------------------------------------------------------------
# Chunking — keep within the embedding model's context window
# ---------------------------------------------------------------------------
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=60
